{
  "name": "qingji-headache-diary",
  "version": "1.3.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "build:stage": "node scripts/stage-installer.mjs",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "test:installer": "node tests/installer-lifecycle.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
